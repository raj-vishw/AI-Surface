# Copy this file to .env.local and adjust as needed. .env* files are
# gitignored except this one — never commit real values here.

# Base URL of a REST API implementing the contract documented in
# src/api/config.ts (e.g. https://api.example.com). Leave unset/empty to
# run against realistic, clearly-marked mock data (src/mocks/) — the
# default, since this backend does not yet expose that REST API (see
# src/api/config.ts's header comment and the frontend implementation
# report's "Backend Changes Required" section).
VITE_API_BASE_URL=
