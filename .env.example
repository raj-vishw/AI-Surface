# Copy this file to .env and adjust as needed. .env is gitignored — never
# commit real credentials. Values below are placeholders for local
# development only and must not be reused anywhere else.

# --- Environment selection -------------------------------------------------
AI_RECON_APP_ENV=development
AI_RECON_CONFIG_DIR=configs

# --- Server -----------------------------------------------------------------
AI_RECON_SERVER_HOST=0.0.0.0
AI_RECON_SERVER_PORT=8080

# --- Database (PostgreSQL) ---------------------------------------------------
# Used both by the server/worker/migrate/cli processes (AI_RECON_DATABASE_*)
# and, for POSTGRES_*, by the postgres container itself in docker-compose.
AI_RECON_DATABASE_HOST=localhost
AI_RECON_DATABASE_PORT=5432
AI_RECON_DATABASE_USER=airecon
AI_RECON_DATABASE_PASSWORD=changeme-dev-password
AI_RECON_DATABASE_NAME=airecon_dev
AI_RECON_DATABASE_SSL_MODE=disable

POSTGRES_USER=airecon
POSTGRES_PASSWORD=changeme-dev-password
POSTGRES_DB=airecon_dev

# --- Redis --------------------------------------------------------------------
AI_RECON_REDIS_ADDRESS=localhost:6379
AI_RECON_REDIS_PASSWORD=
AI_RECON_REDIS_DATABASE=0

# --- HTTP client (internal/httpclient defaults) --------------------------------
AI_RECON_HTTP_TIMEOUT=10s

# --- Logging --------------------------------------------------------------------
AI_RECON_LOG_LEVEL=debug
AI_RECON_LOG_FORMAT=json

# --- Security -------------------------------------------------------------------
# See SECURITY.md. RequireAuthorization/DryRun gate later phases' scanning
# subsystems; Phase 1 only carries these settings through configuration.
AI_RECON_SECURITY_REQUIRE_AUTHORIZATION=true
AI_RECON_SECURITY_DRY_RUN=false
