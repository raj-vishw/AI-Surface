# Copy this file to .env and adjust as needed. .env is gitignored — never
# commit real credentials. Values below are placeholders for local
# development only and must not be reused anywhere else.

# --- Environment selection -------------------------------------------------
AI_SURFACE_APP_ENV=development
AI_SURFACE_CONFIG_DIR=configs

# --- Database (PostgreSQL) ---------------------------------------------------
# Used by the worker/migrate/cli processes (AI_SURFACE_DATABASE_*) and, for
# POSTGRES_*, by the postgres container itself in docker-compose.
AI_SURFACE_DATABASE_HOST=localhost
AI_SURFACE_DATABASE_PORT=5432
AI_SURFACE_DATABASE_USER=aisurface
AI_SURFACE_DATABASE_PASSWORD=changeme-dev-password
AI_SURFACE_DATABASE_NAME=aisurface_dev
AI_SURFACE_DATABASE_SSL_MODE=disable

POSTGRES_USER=aisurface
POSTGRES_PASSWORD=changeme-dev-password
POSTGRES_DB=aisurface_dev

# --- Redis --------------------------------------------------------------------
AI_SURFACE_REDIS_ADDRESS=localhost:6379
AI_SURFACE_REDIS_PASSWORD=
AI_SURFACE_REDIS_DATABASE=0

# --- HTTP client (internal/httpclient defaults) --------------------------------
AI_SURFACE_HTTP_TIMEOUT=10s

# --- Logging --------------------------------------------------------------------
AI_SURFACE_LOG_LEVEL=debug
AI_SURFACE_LOG_FORMAT=json

# --- Security -------------------------------------------------------------------
# See SECURITY.md. RequireAuthorization/DryRun gate later phases' scanning
# subsystems; Phase 1 only carries these settings through configuration.
AI_SURFACE_SECURITY_REQUIRE_AUTHORIZATION=true
AI_SURFACE_SECURITY_DRY_RUN=false
